<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BFGI Department Portal</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        html { scroll-behavior: smooth; }
        .hero-gradient { background: linear-gradient(135deg, #1e3a8a, #1d4ed8, #2563eb); }
    </style>
</head>
<body class="bg-slate-50 text-slate-900 font-sans">

    <header class="relative hero-gradient text-white pt-20 pb-32 px-6 text-center overflow-hidden">
        <div class="relative z-10 max-w-4xl mx-auto">
            <div class="flex justify-center mb-6">
                <div class="bg-white/10 p-4 rounded-full backdrop-blur-sm">
                    <i data-lucide="graduation-cap" class="w-12 h-12 text-blue-200"></i>
                </div>
            </div>
            <h1 class="text-4xl md:text-6xl font-bold tracking-tight mb-4">Department Profile Web Portal</h1>
            <p class="text-xl md:text-2xl font-light text-blue-100 mb-2">Baba Farid Group of Institutions</p>
            <div class="w-24 h-1 bg-blue-400 mx-auto mb-4 rounded-full"></div>
            <p class="text-lg md:text-xl font-medium text-blue-50">Department of Computer and Its Applications</p>
            <div class="mt-8">
                <a href="#about" class="inline-flex items-center gap-2 bg-blue-600 hover:bg-white hover:text-blue-900 text-white font-semibold py-3 px-8 rounded-full transition-all shadow-lg">
                    Explore Now <i data-lucide="arrow-right" class="w-5 h-5"></i>
                </a>
            </div>
        </div>
    </header>

    <nav class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm shadow-md py-4">
        <div class="max-w-7xl mx-auto px-4 flex justify-between items-center">
            <div class="font-bold text-blue-900 text-xl">BFGI Portal</div>
            <div class="flex gap-6">
                <a href="#about" class="hover:text-blue-700 font-semibold">About</a>
                <a href="#courses" class="hover:text-blue-700 font-semibold">Courses</a>
                <a href="#contact" class="hover:text-blue-700 font-semibold">Contact</a>
            </div>
        </div>
    </nav>

    <main class="max-w-7xl mx-auto px-4 -mt-16 relative z-20 pb-20">
        
        <section id="about" class="mb-16">
            <div class="bg-white rounded-2xl shadow-xl p-8 md:p-12 border border-slate-100 grid md:grid-cols-2 gap-12 items-center">
                <div>
                    <h2 class="text-3xl font-bold text-blue-900 border-b-4 border-blue-600 inline-block pb-2 mb-6">About Department</h2>
                    <p class="text-slate-600 leading-relaxed mb-6 text-lg">
                        The Department of Computer and Its Applications provides quality education in programming, software development, AI, ML, and modern IT technologies.
                    </p>
                    <div class="flex gap-4">
                        <span class="flex items-center gap-2 text-blue-700 font-medium bg-blue-50 px-4 py-2 rounded-lg">
                            <i data-lucide="code" class="w-5 h-5"></i> Modern Tech
                        </span>
                        <span class="flex items-center gap-2 text-blue-700 font-medium bg-blue-50 px-4 py-2 rounded-lg">
                            <i data-lucide="brain" class="w-5 h-5"></i> AI Learning
                        </span>
                    </div>
                </div>
                <div class="bg-blue-50 rounded-2xl aspect-video flex items-center justify-center">
                    <i data-lucide="monitor" class="w-32 h-32 text-blue-200"></i>
                </div>
            </div>
        </section>

        <section id="courses" class="mb-16">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-bold text-blue-900 border-b-4 border-blue-600 inline-block pb-2">Courses Offered</h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="bg-white rounded-2xl p-8 shadow-lg border-t-4 border-blue-600 hover:-translate-y-2 transition-transform">
                    <div class="mb-6 p-4 bg-blue-50 w-min rounded-2xl text-blue-600">
                        <i data-lucide="monitor" class="w-8 h-8"></i>
                    </div>
                    <h3 class="text-2xl font-bold text-blue-900 mb-2">BCA</h3>
                    <p class="text-slate-500 text-sm mb-6">Bachelor of Computer Applications - Foundational software development program.</p>
                </div>
                <div class="bg-white rounded-2xl p-8 shadow-lg border-t-4 border-blue-800 hover:-translate-y-2 transition-transform">
                    <div class="mb-6 p-4 bg-blue-50 w-min rounded-2xl text-blue-800">
                        <i data-lucide="brain" class="w-8 h-8"></i>
                    </div>
                    <h3 class="text-2xl font-bold text-blue-900 mb-2">BCA AI & ML</h3>
                    <p class="text-slate-500 text-sm mb-6">Specialized track focusing on intelligent systems and data algorithms.</p>
                </div>
                <div class="bg-white rounded-2xl p-8 shadow-lg border-t-4 border-blue-700 hover:-translate-y-2 transition-transform">
                    <div class="mb-6 p-4 bg-blue-50 w-min rounded-2xl text-blue-700">
                        <i data-lucide="terminal" class="w-8 h-8"></i>
                    </div>
                    <h3 class="text-2xl font-bold text-blue-900 mb-2">MCA</h3>
                    <p class="text-slate-500 text-sm mb-6">Advanced post-graduate program for professional software engineering.</p>
                </div>
            </div>
        </section>

        <section id="contact">
            <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-slate-100 grid md:grid-cols-2">
                <div class="p-8 md:p-12">
                    <h2 class="text-3xl font-bold text-blue-900 border-b-4 border-blue-600 inline-block pb-2 mb-8">Contact Us</h2>
                    <div class="space-y-6">
                        <div class="flex items-center gap-4">
                            <i data-lucide="mail" class="text-blue-600"></i>
                            <span>info@bfgi.edu.in</span>
                        </div>
                        <div class="flex items-center gap-4">
                            <i data-lucide="map-pin" class="text-blue-600"></i>
                            <span>Baba Farid Group, Bathinda</span>
                        </div>
                    </div>
                </div>
                <div class="bg-slate-50 p-8 flex items-center justify-center">
                    <a href="#" class="w-full bg-blue-700 text-white text-center font-bold py-4 rounded-xl shadow-lg hover:bg-blue-800 transition-all">APPLY NOW</a>
                </div>
            </div>
        </section>
    </main>

    <footer class="bg-slate-900 text-slate-400 py-8 text-center">
        <p>© 2026 BFGI Department Profile Portal</p>
    </footer>

    <script>
        lucide.createIcons();
    </script>
</body>
</html>